# ---------------------------------------------------------------------------
# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to .env.local for local development, and add the same values
# as Environment Variables in your Vercel project for deployments.
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: it is powerless
# on its own and every table is guarded by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this app, used for auth email links and reminder links.
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Reminders — ALL OPTIONAL. The app runs fine without any of this; reminder
# channels simply show as unavailable in the profile page until configured.
#
# EVERYTHING BELOW THIS LINE IS A SERVER SECRET. None of these may ever be
# prefixed NEXT_PUBLIC_ — that prefix compiles the value into the browser
# bundle where anyone can read it.
# ---------------------------------------------------------------------------

# Required for ANY reminder delivery, and for Team > Add teammate, which
# creates an account without sending a confirmation email. Supabase > Project
# Settings > API > service_role. This key bypasses every RLS policy, which is
# why only those two places use it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scheduled dispatcher authenticates with. Generate one:
#   openssl rand -hex 32
# Vercel Cron sends it automatically as a Bearer token once set here.
CRON_SECRET=

# --- Notifications on the device (web push) --------------------------------
# Nothing to set. The signing keys are generated on first use and kept in the
# database, in a table only the service role can read — so no private key is
# ever copied through a terminal or a dashboard. It does need
# SUPABASE_SERVICE_ROLE_KEY above, like every other reminder channel.

# --- Email (Resend) --------------------------------------------------------
# resend.com > API Keys. The from address must be on a verified domain.
RESEND_API_KEY=
REMINDER_EMAIL_FROM="Almailgroup Tasks <tasks@yourdomain.com>"

# --- Telegram --------------------------------------------------------------
# Create a bot by messaging @BotFather on Telegram; it gives you the token.
TELEGRAM_BOT_TOKEN=
# The bot's @name, without the @. Used to build the connect link.
TELEGRAM_BOT_USERNAME=
# Any random string. Set the same value when registering the webhook so only
# Telegram can call it: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp (Twilio) -----------------------------------------------------
# twilio.com > Console. The from number must be WhatsApp-enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Optional but usually REQUIRED in production: outside a 24-hour window since
# the user last messaged you, WhatsApp only delivers pre-approved templates.
# Leave blank while testing against the Twilio sandbox.
TWILIO_WHATSAPP_TEMPLATE_SID=

# --- Almail AI ----------------------------------------------------------------
# The assistant works without these: it falls back to a local brain that
# answers the tracking questions it can count from the board.
#
# Point this at the Cloudflare Worker that fronts Gemini. The Worker holds the
# Gemini API key — it never reaches this app, and never reaches the browser.
ALMAIL_AI_WORKER_URL=
# Any random string, set identically on the Worker, so only this app can spend
# your Gemini quota: openssl rand -hex 16
ALMAIL_AI_WORKER_SECRET=
