{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    // The Worker is plain JavaScript so it can be pasted straight into
    // Cloudflare's browser editor; its types live in JSDoc and are checked
    // against the portal's own definitions rather than copied.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The wire types are the portal's own, imported rather than copied, so the
    // two cannot drift. They are type-only, so nothing crosses at runtime.
    "paths": { "@/*": ["../src/*"] },
    "baseUrl": "."
  },
  "include": ["src/**/*.js"]
}
