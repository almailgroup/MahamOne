// Settings shared by the app and its widgets. Values that differ per Mac or
// per Apple account go in Local.xcconfig next to this file (not in git):
//
//   DEVELOPMENT_TEAM = ABCDE12345
//
// See ios/README.md.

APP_BUNDLE_ID = com.almailgroup.mahamone
KEYCHAIN_GROUP = com.almailgroup.mahamone.shared

// Maham One's Supabase project. Only the host: in an xcconfig "//" starts a
// comment, so Info.plist adds the https:// itself.
SUPABASE_HOST = gagdyhintrxdkiqhahzh.supabase.co

// The project's publishable key: public by design, the same one the web app
// ships (src/cloud/config.ts). Never the secret key (sb_secret_…), which the
// app refuses anyway.
SUPABASE_PUBLISHABLE_KEY = sb_publishable_KyVAkWtemw_XDnNK8ZKRpA_-5x4pk8d

#include? "Local.xcconfig"
