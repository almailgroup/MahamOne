# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.tsbuildinfo
# the email-alerts function, built by `npm run build:functions`
supabase/functions/
# the Supabase CLI's own files
supabase/.temp/
supabase/.branches/

# tests
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# local env / editor
.env
.env.*
!.env.example
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# iOS: Swift Package Manager, Xcode and the generated project (ios/project.yml
# is the source; `xcodegen` makes the project from it)
ios/**/.build/
ios/**/.swiftpm/
ios/*.xcodeproj/
ios/DerivedData/
ios/Config/Local.xcconfig
# written by xcodegen from project.yml
ios/App/Info.plist
ios/App/MahamOne.entitlements
ios/Widgets/Info.plist
ios/Widgets/MahamWidgets.entitlements

# Python caches (ios/scripts)
__pycache__/
*.pyc
